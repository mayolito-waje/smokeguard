# ---------------------------------------------------------------------------
# csi_recv_mqtt configuration
#
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
#
# ".env" is listed in .gitignore -- your credentials will not be committed.
# The build turns this file into main/mqtt_config.h at configure time, so
# re-run `idf.py build` after editing it.
#
# Format notes:
#   * "KEY=value", one per line. No spaces around "=".
#   * "#" only starts a comment at the beginning of a line, so passwords
#     may safely contain "#".
#   * Values may be wrapped in 'single' or "double" quotes; the quotes are
#     stripped. Use them if a value has leading/trailing whitespace.
# ---------------------------------------------------------------------------


# --- Wi-Fi (your mobile hotspot) -------------------------------------------
# The ESP32 joins this network. It has to be a 2.4 GHz network.

WIFI_SSID=
WIFI_PASSWORD=


# --- MQTT broker -----------------------------------------------------------
# BROKER HOST: use the broker machine's NAME, not its IP -- that is the whole
# point of this file (a hotspot hands out a new IP on every reconnect).
#
# Plug in the ".local" mDNS name of the machine running the broker, e.g.
#     MQTT_BROKER_HOST=mayo-laptop.local
# Run `hostname` on the broker machine (plus ".local") to get this.
#
# On Linux the broker machine needs Avahi (usually preinstalled) and on
# macOS/Windows, Bonjour. Plain DNS names and literal IPs also work here.

MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883

# Broker credentials. Leave both empty to connect anonymously.
MQTT_USERNAME=
MQTT_PASSWORD=

# Topics. A leading "/" is unusual in MQTT (it creates an empty first level)
# but it is valid and broker-side matching treats it literally.
MQTT_TOPIC_DATA=/home/csi/data
MQTT_TOPIC_STATUS=/home/csi/status

# Client id. Leave empty to derive a unique one from the chip MAC
# (csi-recv-a1b2c3). Must be unique across everything connected to the broker.
MQTT_CLIENT_ID=

# Keepalive in seconds. The broker marks the client dead after 1.5x this.
MQTT_KEEPALIVE_S=60

# How long to wait for an mDNS answer when resolving ".local" names (ms).
MDNS_TIMEOUT_MS=3000

# Hostname this ESP32 advertises over mDNS (handy for pinging it by name).
MDNS_HOSTNAME=csi-recv


# --- Time (NTP) ------------------------------------------------------------
# NTP server used to set the wall clock once Wi-Fi is up. The clock feeds the
# trailing timestamp_real column of every CSI line: UNIX epoch seconds with
# microseconds (e.g. 1785103746.011223), which is 0.000000 until the first
# successful sync. Needs internet or a LAN NTP server reachable on the Wi-Fi.

NTP_SERVER=pool.ntp.org


# --- CSI capture -----------------------------------------------------------
# MAC of the ESP-NOW sender (csi_send). Frames from other MACs are ignored.
CSI_SENDER_MAC=14:C1:9F:28:C1:A0

# Wi-Fi channel the sender transmits on. Used only to warn you when the
# hotspot put the ESP32 on a different channel, which would silence CSI.
# If they differ, set your hotspot to this channel -- or set the sender's
# channel to match the hotspot and update this value.
# 0 disables the check, which is the right setting for csi_send_mqtt: it
# follows the AP like the receiver does, so there is nothing to compare. Use a
# channel number only with the fixed-channel csi_send.
CSI_CHANNEL=0

# How many formatted packets may wait for the broker before the oldest is
# dropped. Higher = more latency tolerance, more RAM.
CSI_QUEUE_DEPTH=32

# Publish a heartbeat on the status topic every N seconds (0 disables).
STATUS_INTERVAL_S=30


# --- Logging ---------------------------------------------------------------
# NONE, ERROR, WARN, INFO, DEBUG or VERBOSE. Applies to all components.
LOG_LEVEL=INFO
