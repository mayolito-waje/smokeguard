# SmokeGuard Backend Configuration
# Copy this file to .env and adjust as needed

# MQTT broker (Mosquitto) — the ESP32 receiver (csi_recv_mqtt) publishes
# CSI CSV lines to the data topic and JSON status to the status topic
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=esp32
MQTT_PASSWORD=mosquitto
MQTT_TOPIC_DATA=home/csi/data
MQTT_TOPIC_STATUS=home/csi/status
# PMS5003 air-quality sensor publishes CSV lines to this topic (QoS 0)
MQTT_TOPIC_SMOKE=home/smoke_sensor/data
MQTT_CLIENT_ID=smokeguard-backend

# CSV replay mode (development without hardware): set to a .csv path to
# replay recorded CSI data instead of subscribing to MQTT
# REPLAY_CSV=./sample_csv_output/sample.csv

# InfluxDB connection
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=<generated by setup_influxdb.sh>
INFLUXDB_ORG=smokeguard
INFLUXDB_BUCKET=csi_data

# InfluxDB local data directory
INFLUXDB_DATA_DIR=./influxdb_data

# Periodic cleanup — readings older than this many days are deleted from
# InfluxDB (export CSVs first: scripts/export_influx_to_csv.py)
CSI_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=0.5   # 30 minutes

# Server
HOST=0.0.0.0
PORT=8000

# Optional: filter by sender MAC (leave empty to accept all)
SENDER_MAC=14:C1:9F:28:C1:A0
