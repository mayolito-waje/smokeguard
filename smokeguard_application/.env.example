# SmokeGuard Backend Configuration
# Copy this file to .env and adjust as needed
#
# Docker Compose note: you do not need this file to run the stack.
# `docker compose up` supplies development defaults and reads a local .env
# only for ${...} interpolation (secrets, MQTT credentials, topics, ports).
# Do not copy the placeholder secrets below into a Docker .env unchanged.

# MQTT broker (Mosquitto) — the ESP32 receiver (csi_recv_mqtt) publishes
# CSI CSV lines to the data topic and JSON status to the status topic
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=esp32
MQTT_PASSWORD=mosquitto
MQTT_TOPIC_DATA=home/csi/data
MQTT_TOPIC_STATUS=home/csi/status
# PMS5003 air-quality sensor publishes CSV lines to this topic (QoS 0)
MQTT_TOPIC_SMOKE=home/smoke_sensor/data
MQTT_CLIENT_ID=smokeguard-backend

# Application-level internet probe (NTP). Drives the dashboard's NTP badge
# and its refresh button; it never rewrites data by itself.
NTP_SERVERS=pool.ntp.org,time.google.com,time.cloudflare.com
NTP_TIMEOUT_S=1.0
NTP_RECHECK_INTERVAL_S=300      # 0 = startup + manual refresh only
# Received live timestamps farther than this from the host clock (or before
# 2020) are replaced from the host clock so offline data still stores.
# scripts/mockup_detection_event.py needs TIMESTAMP_MAX_SKEW_S=3600 for its
# intentionally backdated 600 s smoke baseline.
TIMESTAMP_MAX_SKEW_S=300        # ±5 minutes

# CSV replay mode (development without hardware): set to a .csv path to
# replay recorded CSI data instead of subscribing to MQTT
# REPLAY_CSV=./sample_csv_output/sample.csv

# InfluxDB connection
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=<generated by setup_influxdb.sh>
INFLUXDB_ORG=smokeguard
INFLUXDB_BUCKET=csi_data

# InfluxDB local data directory
INFLUXDB_DATA_DIR=./influxdb_data

# Periodic cleanup — readings older than this many days are deleted from
# InfluxDB (export CSVs first: scripts/export_influx_to_csv.py)
CSI_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=0.5   # 30 minutes

# Server
HOST=0.0.0.0
PORT=8000

# Optional: filter by sender MAC (leave empty to accept all)
SENDER_MAC=

# Smoking-activity detection (real ML pipeline — SVM + ResNet-LSTM + late fusion)
DETECTION_DB_PATH=./detection.db
# Windows: smoke = last 14.905 s of sensor samples; the CSI window starts at
# the same instant (t0) and its duration is scanned 4.0-7.0 s (gesture
# lengths vary), using the most confident candidate.
DETECTION_CSI_MIN_SECONDS=4.0
DETECTION_CSI_MAX_SECONDS=7.0
DETECTION_CSI_STEP_SECONDS=0.5
DETECTION_SMOKE_SECONDS=14.905367895113585
DETECTION_SENSOR_BASELINE_SECONDS=600  # causal baseline before the window
DETECTION_INTERVAL_S=0.2               # evaluation cadence
DETECTION_COOLDOWN_S=30                # alert dedupe window
DETECTION_CSI_MIN_PACKETS=200          # min raw CSI packets to run the model
DETECTION_SMOKE_MIN_WINDOW=8
DETECTION_SMOKE_MIN_BASELINE=30
DETECTION_BASELINE_MIN_PACKETS=300     # static-background capture minimum
# Experimental CSI-only class: enabled at runtime from the dashboard toggle
# (persisted in SQLite, default OFF). These tune its gate/cadence:
DETECTION_CSI_ONLY_MIN_PROB=0.0        # 0 = argmax gate only
DETECTION_CSI_ONLY_INTERVAL_S=1.0      # scan rate cap while the sensor is quiet

# Model artifacts (paths relative to the backend working directory). The
# seven-class CSI checkpoint and its Platt calibrator must share the same
# class list; the backend refuses to load a mismatched pair.
CSI_MODEL_PATH=models/csi_resnet_lstm_7class.keras
CSI_PLATT_PATH=models/csi_resnet_lstm_7class.platt.json
SMOKE_MODEL_PATH=models/smoke_svm_pipeline.joblib

# Decision thresholds / fusion weights (from SmokeGuard_Fusion.ipynb)
SENSOR_PROB_THRESHOLD=0.4049989698494056
FUSION_SCORE_THRESHOLD=0.70
FUSION_CSI_WEIGHT=0.50

# Monthly PDF report (Detection History -> Download PDF report). The logo
# path is relative to the backend working directory; a missing logo falls
# back to a text-only header.
REPORT_FACILITY=DLSU-D PBH320
REPORT_LOGO_PATH=frontend/public/smokeguard_logo.png

# Admin auth (PoC) — generate the two distinct secrets into .env first:
#   bash scripts/setup_auth_secrets.sh
JWT_SECRET=<generated by scripts/setup_auth_secrets.sh>
PASSWORD_RESET_SECRET=<generated by scripts/setup_auth_secrets.sh>
JWT_EXPIRE_DAYS=7
AUTH_DB_PATH=./auth.db

# Frontend build-time — repository used by Model Info source links.
# Vite embeds this into the static bundle at image build time; after changing
# it rebuild the frontend: docker compose up --build -d frontend
VITE_GITHUB_REPO=https://github.com/mayolito-waje/smokeguard
